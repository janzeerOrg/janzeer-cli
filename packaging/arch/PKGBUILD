# Maintainer: Janzeer <janzeeer@proton.me>
# Arch Linux package of the jz release binary (https://github.com/janzeerOrg/janzeer-cli).
# Rendered by release/build-arch-package.sh from the Linux x64 bundle of the same version — do not edit by hand.
pkgname=janzeer-cli-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="jz — command-line client for the Janzeer blockchain: chain reads, live watch, local encrypted wallet, transactions, node operations"
arch=('x86_64')
url="https://github.com/janzeerOrg/janzeer-cli"
license=('Apache-2.0')
depends=('glibc' 'zlib')
provides=('jz')
conflicts=('jz')
options=('!strip' '!debug')
_bundle="jz-${pkgver}-linux-x64"
source=("https://github.com/janzeerOrg/janzeer-cli/releases/download/v${pkgver}/${_bundle}.tar.gz")
sha256sums=('90800c2fc5058fed34abdddfacb7d2894747da3ffe1fb2eeb28383190f7cb1ac')

package() {
  install -Dm755 "$srcdir/$_bundle/jz" "$pkgdir/usr/bin/jz"
  install -Dm644 "$srcdir/$_bundle/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$_bundle/README.txt" "$pkgdir/usr/share/doc/$pkgname/README.txt"
  # shell completions, generated by the binary being packaged
  install -d "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions" "$pkgdir/usr/share/fish/vendor_completions.d"
  "$srcdir/$_bundle/jz" completion bash > "$pkgdir/usr/share/bash-completion/completions/jz"
  "$srcdir/$_bundle/jz" completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_jz"
  "$srcdir/$_bundle/jz" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/jz.fish"
}
