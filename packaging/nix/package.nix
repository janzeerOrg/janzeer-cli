# Nix package for jz, the Janzeer command-line client.
#
# Linux systems wrap the published GraalVM native image (the same tarball the
# Arch and .deb packages use); Darwin systems wrap the published runnable jar
# with a JDK 17+, the same approach as packaging/homebrew/jz.rb. Nothing is
# compiled from source.
#
# To cut a new release, update `version` and the three hashes below — the
# hashes are the ones published in that release's SHA256SUMS file.
{
  lib,
  stdenv,
  fetchurl,
  autoPatchelfHook,
  installShellFiles,
  patchelf,
  makeWrapper,
  jdk17,
  zlib,
}:

let
  version = "0.1.1";
  hashes = {
    linux-x64 = "sha256-kIAML8UFj+00q93frLfSiUdH2j/+H7LusoODGQ98saw=";
    linux-arm64 = "sha256-0oYKRB4cB3Rpt1F5GsbnBPV0A960vMFwRldLuoW6Lfo=";
    jar = "sha256-tEmQg6DSRPsQx42B6FOh69yqAYK4KrRn/EHJuPqOh9k=";
  };

  releaseUrl = "https://github.com/janzeerOrg/janzeer-cli/releases/download/v${version}";

  metaBase = {
    description = "Command-line client for the Janzeer blockchain";
    homepage = "https://janzeer.org";
    license = lib.licenses.asl20;
    mainProgram = "jz";
  };

  # Shell completions are generated by the packaged binary itself, after it
  # has been made runnable on the target system (patchelf / wrapper), exactly
  # like the Arch package does.
  installCompletions = ''
    installShellCompletion --cmd jz \
      --bash <($out/bin/jz completion bash) \
      --zsh <($out/bin/jz completion zsh) \
      --fish <($out/bin/jz completion fish)
  '';

  linuxPkgs = {
    x86_64-linux = {
      asset = "jz-${version}-linux-x64.tar.gz";
      hash = hashes.linux-x64;
    };
    aarch64-linux = {
      asset = "jz-${version}-linux-arm64.tar.gz";
      hash = hashes.linux-arm64;
    };
  };

  linuxPkg =
    let
      asset = linuxPkgs.${stdenv.hostPlatform.system};
    in
    stdenv.mkDerivation {
      pname = "jz";
      inherit version;

      src = fetchurl {
        url = "${releaseUrl}/${asset.asset}";
        inherit (asset) hash;
      };

      # The release tarball contains a single top-level directory
      # (jz-<version>-linux-<arch>/) holding jz, LICENSE.txt and README.txt.
      sourceRoot = lib.removeSuffix ".tar.gz" asset.asset;

      nativeBuildInputs = [
        autoPatchelfHook
        installShellFiles
        patchelf
      ];

      # The native image links only glibc and zlib.
      buildInputs = [
        stdenv.cc.cc.lib
        zlib
      ];

      dontBuild = true;

      installPhase = ''
        runHook preInstall

        install -Dm755 jz $out/bin/jz
        install -Dm644 LICENSE.txt $out/share/doc/jz/LICENSE.txt
        install -Dm644 README.txt $out/share/doc/jz/README.txt

        runHook postInstall
      '';

      # Completions are generated by running the packaged binary, so patch
      # its interpreter and library path explicitly first: autoPatchelfHook
      # only patches after postFixup, which is too late for this.
      postFixup = ''
        patchelf --set-interpreter "$(cat $NIX_CC/nix-support/dynamic-linker)" \
          --set-rpath "${lib.makeLibraryPath [ stdenv.cc.cc.lib zlib ]}" \
          $out/bin/jz
      '' + installCompletions;

      meta = metaBase // {
        platforms = lib.platforms.linux;
        sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
      };
    };

  jarPkg = stdenv.mkDerivation {
    pname = "jz";
    inherit version;

    src = fetchurl {
      url = "${releaseUrl}/jz-${version}.jar";
      hash = hashes.jar;
    };

    nativeBuildInputs = [
      makeWrapper
      installShellFiles
    ];

    dontUnpack = true;

    installPhase = ''
      runHook preInstall

      install -Dm644 $src $out/libexec/jz-${version}.jar
      makeWrapper ${lib.getExe jdk17} $out/bin/jz \
        --add-flags "-jar $out/libexec/jz-${version}.jar"

      runHook postInstall
    '';

    postFixup = installCompletions;

    meta = metaBase // {
      platforms = lib.platforms.darwin;
      sourceProvenance = [ lib.sourceTypes.binaryBytecode ];
    };
  };
in
if stdenv.hostPlatform.isDarwin then jarPkg else linuxPkg
